# Copy this file to .env.local and fill in the values from Supabase.
# Never commit .env.local. Never use the secret or service_role key here.

# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
# (older projects: the "anon public" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
